@startuml
title Project 4 Part 2 - Final CANopen Motor-Control Architecture

top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 35

node "Raspberry Pi - CANopen manager" as Pi {
  component "CANopen management and test tools\nNMT manager | SDO client | PDO tools\ncandump / cansend diagnostics" as PiTools
  component "SocketCAN" as SocketCAN
  component "Linux CAN driver\nand CAN interface" as LinuxCan
  component "CAN transceiver" as PiTransceiver

  PiTools -down-> SocketCAN
  SocketCAN -down-> LinuxCan
  LinuxCan -down-> PiTransceiver
}

cloud "Classical CAN bus\n11-bit identifiers (CAN 2.0A)\n120-ohm termination at both ends" as CanBus

PiTransceiver -down- CanBus

node "Nucleo-L432KC - CANopen node ID 1" as Nucleo {
  package "CAN hardware and Zephyr adapter" as CanPlatform {
    component "External CAN\ntransceiver" as NucleoTransceiver
    component "STM32 CAN controller\n+ Zephyr CAN driver" as ZephyrCanDriver
    component "Zephyr CAN adapter" as ZephyrCanAdapter

    NucleoTransceiver -down-> ZephyrCanDriver : CAN RX / TX
    ZephyrCanDriver -down-> ZephyrCanAdapter : Zephyr frames
  }

  interface "ICan" as ICan

  package "Portable CANopen layer - no Zephyr dependencies" as CanOpen {
    component "CAN frame router\nCOB-ID dispatch" as Router
    component "NMT service\n+ Boot-up / heartbeat" as NmtHeartbeat
    component "Data services\nSDO server | RPDO1 consumer | TPDO1 producer" as DataServices
    component "Little-endian codec" as Encoding
    component "Object dictionary" as ObjectDictionary

    Router -down-> NmtHeartbeat
    Router -down-> DataServices
    DataServices --> Encoding
    DataServices -down-> ObjectDictionary
  }

  package "Motor-control application" as Application {
    component "NMT-aware motor\nstate machine" as StateMachine
    component "Target / profile\nmanagement" as Reference
    component "Periodic control loop" as ControlLoop
    component "P / PI controller" as Controller
    component "Encoder interface" as Encoder
    component "Motor interface" as Motor
    component "Fault and LED\nmanagement" as HardwareState

    StateMachine --> Reference : enable / reset
    Reference --> Controller : velocity reference
    Encoder --> Controller : actual velocity
    ControlLoop --> Controller : periodic update
    Controller --> Motor : signed duty command
    HardwareState <--> StateMachine : fault / status
  }

  package "Zephyr motor I/O" as MotorIo {
    component "Kernel timer" as KernelTiming
    component "GPIO / counter" as GpioCounterDriver
    component "PWM / direction" as PwmDriver
  }

  ZephyrCanAdapter ..down.|> ICan : implements
  ICan -down-> Router : CAN frames

  NmtHeartbeat <--> StateMachine : NMT state

  ObjectDictionary -down-> Reference
  ObjectDictionary -down-> Controller
  Encoder --> ObjectDictionary
  Controller --> ObjectDictionary

  KernelTiming --> ControlLoop : 1 ms tick
  GpioCounterDriver --> Encoder : position / fault input
  PwmDriver --> Motor : PWM / direction output
}

CanBus -down- NucleoTransceiver

note right of ICan
  Portable CAN-frame interface.
  The CANopen layer contains
  no Zephyr API calls.
end note

note right of ObjectDictionary
  |= Index |= Object |= Access |
  | 0x1000 | Device type | RO |
  | 0x2000 | Controller type | RW |
  | 0x2001 | Kp | RW |
  | 0x2002 | Ti | RW |
  | 0x2010 | Output duty cycle | RO |
  | 0x606C | Velocity actual value | RO |
  | 0x6083 | Profile acceleration | RW |
  | 0x6084 | Profile deceleration | RW |
  | 0x60FF | Target velocity | RW |
end note

legend left
  |= Layer |= Responsibility |
  | Raspberry Pi | CANopen management, test and diagnostics |
  | CAN hardware / adapter | CAN physical link and Zephyr boundary |
  | Portable CANopen | Protocol services and object dictionary |
  | Motor-control application | State, profile and closed-loop control |
  | Zephyr motor I/O | Timing, encoder, fault and motor outputs |
endlegend

@enduml
