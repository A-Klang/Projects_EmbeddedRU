#include <zephyr/dt-bindings/gpio/gpio.h>   /* GPIO_ACTIVE_LOW, GPIO_PULL_UP */
#include <zephyr/dt-bindings/pwm/pwm.h>   /* PWM_MSEC, PWM_POLARITY_NORMAL */

/ {
	aliases {
		led0 = &led_0;
	};
	leds {
		compatible = "gpio-leds";
		led_0: led_0 {
			gpios = <&gpiob 3>;
		};
	};
};

/ {
	aliases {
		sw1 = &user_button;
	};

	buttons {
		compatible = "gpio-keys";
		user_button: button_0 {
			gpios = <&gpioa 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    label = "External button";
		};
	};
};

/ {
	aliases {
		c1-pin = &c1_node;
		c2-pin = &c2_node;
		pwm-pin = &pwm_node;
		dir-pin = &dir_node;
		flt-pin = &flt_node;
	};
	pins {
		compatible = "gpio-keys";
		c1_node: pin_b7 { /* d4 */
			gpios = <&gpiob 7>;
		};
		c2_node: pin_b0 { /* d3 */
			gpios = <&gpiob 0>;
		};
		pwm_node: pin_a8 { /* d9 */
			gpios = <&gpioa 8>;
		};
		dir_node: pin_a11 { /* d10 */
			gpios = <&gpioa 11>;
		};
		flt_node: pin_b6 { /* d5 */
			gpios = <&gpiob 6>;
		};
	};
};